#include <stdio.h>

int main()
{
    int arr[20] = {1, 3, 4, 6, 7, 8, 10, 43, 11};
    int count = 9;
    int i, key, pos, value;
    int largest, smallest;

    /* Q1..Traversse Array */

    printf("Array elements are: ");

    for(i = 0; i < count; i++)
    {
        printf("%d ", arr[i]);
    }


    /* Q2...Linear Search */

    printf("\n\nEnter elementto search: ");
    scanf("%d", &key);

    for(i = 0; i < count; i++)
    {
        if(arr[i] == key)
        {
            printf("Found at position %d", i + 1);
            break;
        }
    }

    if(i == count)
    {
        printf("Element not found");
    }


    /* Q3..MaxElement */

    largest = arr[0];

    for(i = 1; i < count; i++)
    {
        if(arr[i] > largest)
        {
            largest = arr[i];
        }
    }

    printf("\n\nMaximum element is: %d", largest);


    /* Q4..MinElement */

    smallest = arr[0];

    for(i = 1; i < count; i++)
    {
        if(arr[i] < smallest)
        {
            smallest = arr[i];
        }
    }

    printf("\nMinimum element is: %d", smallest);


    /* Q5..Insertion at Beginning */

    printf("\n\nEnter element to insert at beginning: ");
    scanf("%d", &value);

    for(i = count; i > 0; i--)
    {
        arr[i] = arr[i - 1];
    }

    arr[0] = value;
    count++;

    printf("After insertion at beginning: ");

    for(i = 0; i < count; i++)
    {
        printf("%d ", arr[i]);
    }


    /* Q6..Insertn at Given Position */

    printf("\n\nEnter element to insert: ");
    scanf("%d", &value);

    printf("Enter position: ");
    scanf("%d", &pos);

    if(pos >= 1 && pos <= count + 1)
    {
        for(i = count; i >= pos; i--)
        {
            arr[i] = arr[i - 1];
        }

        arr[pos - 1] = value;
        count++;

        printf("After insertion at position %d: ", pos);

        for(i = 0; i < count; i++)
        {
            printf("%d ", arr[i]);
        }
    }
    else
    {
        printf("Invalid position");
    }


    /* Q7..Insertion at End */

    printf("\n\nEnter element to insert at end: ");
    scanf("%d", &value);

    arr[count] = value;
    count++;

    printf("After insertion at end: ");

    for(i = 0; i < count; i++)
    {
        printf("%d ", arr[i]);
    }


    /* Q8..Deletion at Beginning */

    for(i = 0; i < count - 1; i++)
    {
        arr[i] = arr[i + 1];
    }

    count--;

    printf("\n\nAfter deletion at beginning: ");

    for(i = 0; i < count; i++)
    {
        printf("%d ", arr[i]);
    }


    /* Q9.Deletion at Given Position */

    printf("\n\nEnter position to delete: ");
    scanf("%d", &pos);

    if(pos >= 1 && pos <= count)
    {
        for(i = pos - 1; i < count - 1; i++)
        {
            arr[i] = arr[i + 1];
        }

        count--;

        printf("After deletion at position %d: ", pos);

        for(i = 0; i < count; i++)
        {
            printf("%d ", arr[i]);
        }
    }
    else
    {
        printf("Invalid position");
    }


    /* Q10Deletion aat End */

    count--;

    printf("\n\nAfter deletion at end: ");

    for(i = 0; i < count; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}        
